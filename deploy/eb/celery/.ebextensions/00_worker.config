# Celery is not an HTTP app. Prefer a single instance without a load balancer
# so EB does not expect nginx → container health checks to succeed.
option_settings:
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: none
  aws:elasticbeanstalk:application:environment:
    RUN_MIGRATE: "false"
