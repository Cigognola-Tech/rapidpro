# Docker-on-EB keeps host nginx on :80 and proxies to the container bridge IP:8000.
# HostPort publish is unreliable on this platform; the shared ALB process/TG must use port 80.
#
# If the target group is still on :8000, change it in EB Configuration (or EC2 → Target Groups)
# to HTTP port 80 with health check path /health — that matches curl http://127.0.0.1/health.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: "8000"
  aws:elasticbeanstalk:environment:process:default:
    Port: 80
    Protocol: HTTP
    HealthCheckPath: /health
    MatcherHTTPCode: "200"
    HealthCheckInterval: 15
    HealthCheckTimeout: 5
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
