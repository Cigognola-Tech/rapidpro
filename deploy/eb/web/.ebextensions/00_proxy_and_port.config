# Container answers /health on :8000, but host nginx was returning 502 to the ALB.
# Disable the platform reverse proxy and publish container 8000 on host port 80 so
# the load balancer reaches gunicorn directly.
option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: none
  aws:elasticbeanstalk:application:environment:
    PORT: "8000"
  aws:elasticbeanstalk:environment:process:default:
    Port: 80
    Protocol: HTTP
    HealthCheckPath: /health
    MatcherHTTPCode: "200"
    HealthCheckInterval: 15
    HealthCheckTimeout: 5
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
